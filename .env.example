# Copy this file to .env.local and fill in your values

# Admin password for the admin panel
ADMIN_PASSWORD=change_me_in_production

# JWT secret for admin sessions (generate a random string)
JWT_SECRET=your_jwt_secret_here_at_least_32_chars

# Site URL (used for SEO and sitemap)
NEXT_PUBLIC_SITE_URL=https://softlab.unimore.it

# GitHub token (optional: for triggering publication refresh via GitHub Actions)
GITHUB_TOKEN=

# Google Scholar user ID for publications (used by the GitHub Action)
SCHOLAR_USER_ID=A68h4-8AAAAJ

# Semantic Scholar author ID for Francesco Guerra.
# Find it at: https://www.semanticscholar.org/search?q=Francesco+Guerra+Modena&sort=Relevance&authors=
# Copy the numeric ID from the URL (e.g. /author/Francesco-Guerra/1234567) and set it here
# to make the admin "Refresh" button work faster and more reliably.
S2_AUTHOR_ID=
